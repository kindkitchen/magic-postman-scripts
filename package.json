{
  "name": "magic-postman-scripts",
  "version": "2.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "packageManager": "yarn@4.18.1",
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "build": "yarn typecheck && node scripts/build.js",
    "start": "yarn build",
    "transpile": "yarn typecheck",
    "clean": "node scripts/build.js --clean",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/regression.test.js",
    "test:postman": "node tests/postman-smoke.js",
    "check:bundle": "node scripts/build.js --check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "yarn typecheck && yarn format:check && yarn test && yarn check:bundle",
    "gitam": "yarn check && git add -A && git commit",
    "pr": "yarn gitam && git push origin dev && gh pr create --fill-verbose && gh pr merge --auto --merge"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "prettier": "^3.9.10",
    "typescript": "^5.8.2"
  }
}
